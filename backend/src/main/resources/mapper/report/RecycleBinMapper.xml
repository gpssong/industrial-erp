<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.industrial.erp.modules.report.mapper.RecycleBinMapper">

    <!-- ===================================================================
         v1.1.68 回收站. 原生 SQL, 显式 WHERE deleted=1, 绕过 @TableLogic.
         表名/FK 列 (${headTable}/${detailTable}/${detailFk}) 只可能取自
         RecycleType 白名单枚举 (service 层解析后传参), 不接前端原值, 无注入面.
         通用列: bill_no / bill_date / bill_status / update_time / deleted.
         例外: prd_bom 用 status (非 bill_status), 无 bill_date.
         =================================================================== -->

    <!-- 类别名来源 (按 headTable 选列). 输出别名 "category". -->
    <sql id="categoryColumn">
        <choose>
            <when test="headTable == 'pur_order' or headTable == 'pur_receipt'
                       or headTable == 'pur_return'">h.supplier_name</when>
            <when test="headTable == 'sal_order' or headTable == 'sal_delivery'
                       or headTable == 'sal_return'">h.customer_name</when>
            <when test="headTable == 'prd_order' or headTable == 'prd_bom'">h.product_name</when>
            <when test="headTable == 'prd_requisition'">h.prd_order_no</when>
            <when test="headTable == 'inv_check'">h.warehouse_name</when>
            <when test="headTable == 'inv_transfer'">w.warehouse_name</when>
            <otherwise>NULL</otherwise>
        </choose>
    </sql>

    <!-- 状态列: prd_bom 用 status, 其余用 bill_status. -->
    <sql id="statusColumn">
        <choose>
            <when test="headTable == 'prd_bom'">h.status AS billStatus</when>
            <otherwise>h.bill_status AS billStatus</otherwise>
        </choose>
    </sql>

    <!-- 单号列: prd_bom 用 bom_code (无 bill_no), 其余用 bill_no. -->
    <sql id="billNoColumn">
        <choose>
            <when test="headTable == 'prd_bom'">h.bom_code AS billNo</when>
            <otherwise>h.bill_no AS billNo</otherwise>
        </choose>
    </sql>

    <!-- 单据日期列: prd_bom 无 bill_date, 退用 create_time, 其余用 bill_date. -->
    <sql id="billDateColumn">
        <choose>
            <when test="headTable == 'prd_bom'">h.create_time AS billDate</when>
            <otherwise>h.bill_date AS billDate</otherwise>
        </choose>
    </sql>

    <!-- 单号搜索列 (keyword LIKE 用): prd_bom 用 bom_code. -->
    <sql id="billNoSearchColumn">
        <choose>
            <when test="headTable == 'prd_bom'">h.bom_code</when>
            <otherwise>h.bill_no</otherwise>
        </choose>
    </sql>

    <!-- 单据日期搜索列 (startDate/endDate 用): prd_bom 用 create_time. -->
    <sql id="billDateSearchColumn">
        <choose>
            <when test="headTable == 'prd_bom'">h.create_time</when>
            <otherwise>h.bill_date</otherwise>
        </choose>
    </sql>

    <!-- 商品 (聚合明细 product_name). 注意: 不是所有 detail 表都有 line_no 列
         (inv_check_detail / inv_transfer_detail 无), 故不 ORDER BY line_no,
         直接 GROUP_CONCAT(DISTINCT) 避免依赖该列. 无 detail 的 prd_order 取 head.product_name. -->
    <sql id="productColumn">
        <choose>
            <when test="headTable == 'prd_order'">
                h.product_name AS productNames
            </when>
            <when test="hasDetail">
                (SELECT GROUP_CONCAT(DISTINCT p.product_name SEPARATOR ', ')
                 FROM ${detailTable} dtl
                 LEFT JOIN base_product p ON p.id = dtl.product_id
                 WHERE dtl.${detailFk} = h.id AND dtl.deleted = 0) AS productNames
            </when>
            <otherwise>NULL AS productNames</otherwise>
        </choose>
    </sql>

    <!-- 金额: 仅 6 类业务单据有 total_amount; 生产/盘点/调拨/BOM 无金额列. -->
    <sql id="amountColumn">
        <choose>
            <when test="headTable == 'pur_order' or headTable == 'pur_receipt'
                       or headTable == 'pur_return' or headTable == 'sal_order'
                       or headTable == 'sal_delivery' or headTable == 'sal_return'">
                h.total_amount AS totalAmount
            </when>
            <otherwise>NULL AS totalAmount</otherwise>
        </choose>
    </sql>

    <select id="listDeleted" resultType="java.util.Map">
        SELECT
            h.id AS id,
            <include refid="billNoColumn"/>,
            <include refid="billDateColumn"/>,
            <include refid="statusColumn"/>,
            h.update_time AS updateTime,
            <include refid="categoryColumn"/> AS category,
            <include refid="productColumn"/>,
            <include refid="amountColumn"/>,
            u.username AS deletedBy
        FROM ${headTable} h
        <!-- v1.1.71: 删除人 = update_by 解析 (sys_user.username). 业务删除只对 DRAFT 开放,
             update_by 是最后一次写入者 (删除动作), 无专门 deleted_by 列, 故用 update_by 近似. -->
        LEFT JOIN sys_user u ON u.id = h.update_by AND u.deleted = 0
        <choose>
            <when test="headTable == 'inv_transfer'">
                LEFT JOIN base_warehouse w ON w.id = h.out_warehouse_id AND w.deleted = 0
            </when>
        </choose>
        WHERE h.deleted = 1
        <if test="keyword != null and keyword != ''">
            AND ( <include refid="billNoSearchColumn"/> LIKE CONCAT('%', #{keyword}, '%')
            <choose>
                <when test="headTable == 'pur_order' or headTable == 'pur_receipt'
                           or headTable == 'pur_return'">
                    OR h.supplier_name LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="headTable == 'sal_order' or headTable == 'sal_delivery'
                           or headTable == 'sal_return'">
                    OR h.customer_name LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="headTable == 'prd_order' or headTable == 'prd_bom'">
                    OR h.product_name LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="headTable == 'prd_requisition'">
                    OR h.prd_order_no LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="headTable == 'inv_check'">
                    OR h.warehouse_name LIKE CONCAT('%', #{keyword}, '%')
                </when>
                <when test="headTable == 'inv_transfer'">
                    OR w.warehouse_name LIKE CONCAT('%', #{keyword}, '%')
                </when>
            </choose>
            )
        </if>
        <if test="startDate != null and startDate != ''">
            AND <include refid="billDateSearchColumn"/> &gt;= #{startDate}
        </if>
        <if test="endDate != null and endDate != ''">
            AND <include refid="billDateSearchColumn"/> &lt;= #{endDate}
        </if>
        ORDER BY h.update_time DESC, h.id DESC
    </select>

    <select id="peekHead" resultType="java.util.Map">
        SELECT id, deleted,
        <choose>
            <when test="headTable == 'prd_bom'">status AS billStatus</when>
            <otherwise>bill_status AS billStatus</otherwise>
        </choose>
        FROM ${headTable}
        WHERE id = #{id}
    </select>

    <update id="restoreHead">
        UPDATE ${headTable} SET deleted = 0 WHERE id = #{id} AND deleted = 1
    </update>

    <update id="restoreDetail">
        UPDATE ${detailTable} SET deleted = 0 WHERE ${detailFk} = #{headId} AND deleted = 1
    </update>

    <delete id="physicalDeleteDetail">
        DELETE FROM ${detailTable} WHERE ${detailFk} = #{headId}
    </delete>

    <delete id="physicalDeleteHead">
        DELETE FROM ${headTable} WHERE id = #{id}
    </delete>

</mapper>
