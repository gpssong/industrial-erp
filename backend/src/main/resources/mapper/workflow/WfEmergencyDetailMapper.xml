<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.industrial.erp.modules.workflow.mapper.WfEmergencyDetailMapper">
    <select id="selectByPlanId" resultType="com.industrial.erp.modules.workflow.entity.WfEmergencyDetail">
        SELECT * FROM wf_emergency_detail WHERE plan_id = #{planId} AND deleted = 0 ORDER BY step_no, id
    </select>
</mapper>
