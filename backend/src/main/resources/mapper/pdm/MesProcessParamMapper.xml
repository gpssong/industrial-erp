<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.industrial.erp.modules.pdm.mapper.MesProcessParamMapper">

  <select id="selectByProcessDefId" resultType="com.industrial.erp.modules.pdm.entity.MesProcessParam">
    SELECT * FROM mes_process_param
    WHERE process_def_id = #{processDefId} AND deleted = 0
    ORDER BY sort_no ASC, id ASC
  </select>

</mapper>
