# ====================================================================
# ⚠️  安全预检 (v1.1.49) — 启动前必须用强密钥替换所有 CHANGE_ME_ 占位值
#
#   生成 MySQL 密码:
#     openssl rand -base64 24   # 输出 ≈ 32 字符 base64, 存到 MYSQL_ROOT_PASSWORD
#
#   生成 JWT secret (必须在 ≥32 字符, 项目 SecurityPreflightValidator 校验):
#     openssl rand -hex 32      # 输出 64 字符十六进制
#
#   生成后写入 .env (不要 commit .env, 它已在 .gitignore), 然后:
#     docker compose restart backend   # 应用新密钥
#
#   密钥泄漏后果: 攻击者可伪造 token 越权访问, 或猜出数据库密码直连 MySQL.
# ====================================================================
# 工业 ERP 环境变量样例
# 复制为 .env 后按需修改; 不要把真实 .env 提交到 git

# ---------- MySQL ----------
# ⚠️  必改: 用强随机密码替换. 生成命令: openssl rand -base64 24
# ⚠️  注意: MYSQL_ROOT_PASSWORD 同时影响 SPRING_DATASOURCE_PASSWORD (compose 里同一个值),
#          不要单独改 SPRING_DATASOURCE_PASSWORD, 会让两个不一致导致连接失败.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- 后端 Spring Boot (SPRING_DATASOURCE_*) ----------
# Docker 部署: 使用完整 JDBC URL (docker-compose.yml 使用 SPRING_DATASOURCE_URL)
# 源码部署: 改成主机 IP, 如 192.168.1.100
# ⚠️  P2-7: 不再使用拆分字段 (HOST/PORT/DB), 改用完整 URL
# ⚠️  SPRING_DATASOURCE_PASSWORD 应与 MYSQL_ROOT_PASSWORD 保持一致 (都等于 mysql 密码)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/industrial_erp?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- 后端 Redis ----------
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=

# ---------- 后端 ERP_* 自定义配置 ----------
# 上传目录 (生产建议挂载到独立卷; docker-compose.yml 已挂载到 ./data/upload)
ERP_UPLOAD_PATH=/opt/industrial-erp/upload

# 数据备份路径
ERP_BACKUP_PATH=/opt/industrial-erp/backup
ERP_BACKUP_SQL_PATH=/opt/industrial-erp/sql
ERP_BACKUP_RETENTION_DAYS=30

# mysqldump / mysql 命令路径, 留空走 $PATH
# Docker 镜像内: /usr/bin/mysqldump, /usr/bin/mysql
# macOS Homebrew: /opt/homebrew/bin/mysqldump, /opt/homebrew/bin/mysql
# Linux: /usr/bin/mysqldump, /usr/bin/mysql
ERP_MYSQLDUMP=mysqldump
ERP_MYSQL=mysql

# ---------- 飞鹅云打印默认账号 ----------
# 飞鹅云打印 (FeiePrintClient) 调用时, 若前端未传 user 参数则读取此环境变量.
# 不配置将导致 testConnection / printMsg 在 user 为空时抛 RuntimeException.
FEIE_DEFAULT_USER=CHANGE_ME_FEIE_ACCOUNT

# ---------- AI 集成 (v1.1.75 起, 可选) ----------
# 通用 LLM 网关 (OpenAI 兼容协议), 走 backend 端点 LlmClient.
# 不配置 ERP_AI_API_KEY 时 AI 端点快速失败并提示"未配置", 不影响其他功能.
# 推荐走 OpenAI 兼容端点 (通义 DashScope / DeepSeek / OpenRouter 等). 示例:
#   通义:  ERP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  ERP_AI_MODEL=qwen-plus
#   DeepSeek: ERP_AI_BASE_URL=https://api.deepseek.com/v1                      ERP_AI_MODEL=deepseek-chat
ERP_AI_API_KEY=
ERP_AI_MODEL=qwen-plus
ERP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ERP_AI_TIMEOUT_MS=60000

# ---------- AI Failover (v1.1.77 起, 可选) ----------
# LlmClient 改为 provider 链 + cooldown + thinking strip. 只配 legacy 4 env 时行为与 v1.1.75 完全一致.
# 启用 failover: 配 ERP_AI_PROVIDERS=agnes,minimax (或单家), 再填各 slot 的 KEY/MODEL/BASE_URL.
#   - providers 为空 → 回退 legacy (单 provider, 无 failover).
#   - 某 slot key 空 → 该 provider 不参与 chain (跳过).
#   - 触发 failover 的错误: 5xx / 408 / Hutool HttpException (超时/网络) / 429 quota + 429 通用.
#   - 不触发 failover: 401/403/400/业务错误 (choices 空/JSON 坏), 直接抛错不切.
#   - cooldown: 短 5min (5xx/timeout), 长 30min (429 quota). 冷却期间直接跳过该 provider.
#   - thinking strip: 推理模型 (MiniMax 等) 输出 <thinking>...</thinking> 自动剥离; 非推理模型无害.
# 示例 (Agnes 主, MiniMax 备用; minimax key 留空表示该家 disabled):
#ERP_AI_PROVIDERS=agnes,minimax
#ERP_AI_PROVIDER0_NAME=agnes
#ERP_AI_PROVIDER0_KEY=sk-ag-your-agnes-key
#ERP_AI_PROVIDER0_MODEL=agnes-2.5-flash
#ERP_AI_PROVIDER0_BASE_URL=https://apihub.agnes-ai.com/v1
#ERP_AI_PROVIDER0_STRIP_THINKING=false
#ERP_AI_PROVIDER1_NAME=minimax
#ERP_AI_PROVIDER1_KEY=                       # 留空 = 该家 disabled
#ERP_AI_PROVIDER1_MODEL=MiniMax-M3
#ERP_AI_PROVIDER1_BASE_URL=https://api.minimaxi.com/v1
#ERP_AI_PROVIDER1_STRIP_THINKING=true
#ERP_AI_FAILOVER_COOLDOWN_MS=300000
#ERP_AI_FAILOVER_COOLDOWN_LONG_MS=1800000
#ERP_AI_STRIP_THINKING=true

# ---------- AI 语音输入 ASR (v1.1.78 起, 可选) ----------
# App 端 AI 助手语音输入的后端兜底: 原生 App 端录音上传 POST /ai/asr,
# 后端 DashScope 录音文件识别 (paraformer-v2) 转文字回填输入框. H5 端走浏览器
# Web Speech API 端侧识别, 不触发本配置. 不配 ERP_AI_ASR_KEY 时 /ai/asr 快速失败.
# DashScope ASR 是 OpenAI 不兼容协议, key 可复用通义 LLM key (同账号). 示例:
#   通义 ASR: ERP_AI_ASR_KEY=sk-...  ERP_AI_ASR_MODEL=paraformer-v2
#ERP_AI_ASR_KEY=
#ERP_AI_ASR_MODEL=paraformer-v2
#ERP_AI_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/asr
#ERP_AI_ASR_TIMEOUT_MS=30000

# ⚠️  JWT 签名密钥 (v1.1.49 起启动期 SecurityPreflightValidator 强制校验):
#     - 长度 ≥32 字符
#     - 不在已知弱密钥黑名单 (industrial-erp-jwt-test-p2-fix / erp_jwt_secret_2026_gpssong_xxxx 等)
# 生成命令: openssl rand -hex 32   # 输出 64 字符十六进制
SA_TOKEN_JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32

# ---------- CORS 跨域白名单 ----------
# 逗号分隔的完整 Origin (含协议), 仅列表内的前端域名可通过浏览器调 API.
# Spring CORS 因 allowCredentials=true 不支持通配, 必须逐个列出 (Vite 那边一行通配即可, 代码已写好).
# ⚠️  生产/公网部署: 一定要在 .env 覆盖本项, 列真实域名, 否则 application.yml 中的 localhost 默认值会暴露 API.
# 部署到 NAS 公网时, 取消下面这行注释并改成你真实的域名, 删掉 localhost 条目:
#ERP_CORS_ALLOWED_ORIGINS=http://home.93gushi.com:8088,https://home.93gushi.com:8089,https://home.93gushi.com,http://home.93gushi.com,http://n150.93gushi.com:8088,https://n150.93gushi.com:8088,http://192.168.0.150:8088,http://192.168.0.150,http://192.168.0.150:18080,http://192.168.0.150:5173,http://192.168.0.150:5174,http://localhost:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:8080,http://localhost/*,http://127.0.0.1/*
# 注意: 不要带路径, 不要带尾斜杠; 非默认端口必须写, 如 https://erp.93gushi.com:8443

# ====================================================================
# NAS (群晖 DS918+) 部署速查
# ====================================================================
# 1. DSM 套件中心安装 Container Manager
# 2. 把项目传到 /volume1/docker/erp-system/  (含 docker-compose.yml, .env, backend/, pc-web/, sql/)
# 3. 改 MYSQL_ROOT_PASSWORD / SPRING_DATASOURCE_PASSWORD 为强密码
# 4. Container Manager -> 项目 -> 创建 -> 选 docker-compose.yml -> 构建并启动
# 5. 首次构建 5-15 分钟, 跑起来后:
#      PC 前台: http://NAS的IP
#      接口文档: http://NAS的IP:8080/api/doc.html
#      默认账号: admin / admin123
# 6. 公网访问务必走 DSM 反向代理 + HTTPS (控制面板 -> 登录门户 -> 反向代理)
#    多子域: 反代可建多条, 来源分别用 93gushi.com / www.93gushi.com / home.93gushi.com,
#    目的地统一指 HTTP 127.0.0.1:80, 由容器内 nginx 按 host 头分发
# 7. Hyper Backup 备份 /volume1/docker/erp-system/ 整个目录
# 8. 详细: docs/17_群晖NAS部署指南.md (含 9 个 FAQ) + docs/02_部署方案.md

# ---------- AI RAG 语料目录 (v1.1.75, 可选) ----------
# docs/*.md 等切块做检索问答. 指向容器内路径 (部署时把语料挂进容器 /opt/app/ai-corpus).
ERP_RAG_CORPUS_DIR=
